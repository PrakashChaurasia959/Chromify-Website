# ==========================================================
# CHROMIFY WEBSITE — SUPABASE CONFIGURATION TEMPLATE
# ==========================================================

# 1. Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Frontend Public / Anon / Publishable Key (sb_publishable_... or anon JWT)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 3. Authorized Admin Password Configuration (optional local fallback)
VITE_ADMIN_PASSWORD=your-admin-password-here

# 4. Server-Side Secret Key (DO NOT prefix with VITE_)
# Strictly for Supabase Edge Functions or backend secrets. NEVER expose in frontend code!
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
